# ======================================================
# 环境变量配置模板
# 使用方式：复制此文件为 .env，然后填入实际值
# cp .env.example .env
# ======================================================

# 数据库配置
DB_URL=jdbc:mysql://localhost:3306/cpr_db?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# JWT 配置
JWT_SECRET=your_jwt_secret_key_at_least_32_characters
JWT_EXPIRATION_MS=86400000

# DeepSeek AI 问答配置
QA_API_KEY=your_deepseek_api_key
QA_API_URL=https://api.deepseek.com/v1/chat/completions
QA_API_MODEL=deepseek-chat

# 种子账号初始密码（BE-B-06：未设置时后端生成随机密码并打印 WARN 日志，首登强制改密）
CPR_ADMIN_PASSWORD=your_admin_seed_password
CPR_TEST_PASSWORD=your_test_seed_password

# ECS 部署脚本 SSH 密码（deploy/deploy-to-ecs.py 读取；未设置直接中止，无硬编码回退）
CPR_ECS_SSH_PASSWORD=your_ecs_ssh_password
