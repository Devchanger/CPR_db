# ======================================================
# 生息守护 CPR 急救系统 - 环境变量配置模板
# 使用方式：复制此文件为 .env，然后填入实际值
# cp .env.example .env
# ======================================================

# ---------- 数据库 ----------
# MySQL 连接地址，确保数据库已创建(Hibernate 会自动建表)
DB_URL=jdbc:mysql://localhost:3306/cpr_db?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# ---------- JWT ----------
# secret 至少 32 字符(HMAC-SHA256 要求 256 bit), 生产环境请用随机字符串
JWT_SECRET=your_jwt_secret_key_at_least_32_characters
# token 有效期(毫秒), 86400000 = 24小时
JWT_EXPIRATION_MS=86400000

# ---------- DeepSeek AI 问答 ----------
# 填入你的 DeepSeek API Key, 留空则 AI 问答接口返回提示信息
# 获取地址: https://platform.deepseek.com/api_keys
QA_API_KEY=your_deepseek_api_key
QA_API_URL=https://api.deepseek.com/v1/chat/completions
QA_API_MODEL=deepseek-chat
