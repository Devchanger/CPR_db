# CPR_db 生产环境变量模板（由 systemd EnvironmentFile=/opt/cpr-db/.env 加载）
# 复制为 .env 并替换为真实强随机值后再部署；本文件为占位模板，不含真实密钥。
# 说明：deploy-to-ecs.py 在本地没有 .env 时会自动用本文件生成服务器端的 .env。

# ---- 数据库 ----
CPR_DB_URL=jdbc:mysql://localhost:3306/cpr_db?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
CPR_DB_USERNAME=cpr_user
CPR_DB_PASSWORD=CHANGE_ME_REAL_DB_PASSWORD

# ---- JWT（至少 32 位强随机） ----
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRATION_MS=86400000

# ---- 初始账号密码（DataSeeder 未设置时生成随机密码；设置后用于 admin/testuser；首次登录强制改密） ----
CPR_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
CPR_TEST_PASSWORD=CHANGE_ME_TEST_PASSWORD

# ---- ECS SSH 密码（仅 deploy-to-ecs.py 本地使用） ----
CPR_ECS_SSH_PASSWORD=CHANGE_ME_ECS_SSH_PASSWORD

# ---- CORS：生产前端真实域名（逗号分隔，禁止 *） ----
CPR_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- QA / RAG（可选，留空则功能降级） ----
QA_API_KEY=
QA_API_URL=
QA_API_MODEL=
